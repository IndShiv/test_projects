{
  "name": "motion-graphics",
  "version": "1.0.0",
  "private": true,
  "description": "Motion graphics for videos, built with Remotion",
  "scripts": {
    "studio": "remotion studio",
    "render:overfitting": "remotion render Overfitting out/overfitting.mov --codec=prores --prores-profile=4444 --pixel-format=yuva444p10le --image-format=png",
    "render:overfitting:webm": "remotion render Overfitting out/overfitting.webm --codec=vp9 --pixel-format=yuva420p --image-format=png",
    "render:overfitting:preview": "remotion render OverfittingPreview out/overfitting-preview.mp4",
    "render:intro": "remotion render OverfittingIntro out/overfitting-intro.mov --codec=prores --prores-profile=4444 --pixel-format=yuva444p10le --image-format=png",
    "render:intro:webm": "remotion render OverfittingIntro out/overfitting-intro.webm --codec=vp9 --pixel-format=yuva420p --image-format=png",
    "render:intro:preview": "remotion render OverfittingIntroPreview out/overfitting-intro-preview.mp4",
    "render:focus": "remotion render OverfittingFocus out/overfitting-focus.mov --codec=prores --prores-profile=4444 --pixel-format=yuva444p10le --image-format=png",
    "render:focus:webm": "remotion render OverfittingFocus out/overfitting-focus.webm --codec=vp9 --pixel-format=yuva420p --image-format=png",
    "render:focus:preview": "remotion render OverfittingFocusPreview out/overfitting-focus-preview.mp4",
    "render:iteration": "remotion render Iteration out/iteration.mov --codec=prores --prores-profile=4444 --pixel-format=yuva444p10le --image-format=png",
    "render:iteration:webm": "remotion render Iteration out/iteration.webm --codec=vp9 --pixel-format=yuva420p --image-format=png",
    "render:iteration:preview": "remotion render IterationPreview out/iteration-preview.mp4",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.537",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.537"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
